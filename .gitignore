# ── Python runtime ──────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ── Virtual environments ────────────────────────────────────
.venv/
venv/
env/

# ── HAWK runtime data (engagement data — NEVER commit) ──────
sessions/*
outputs/*
payloads/*
reports/*
dicts/*
tmp/*
cache/*
logs/*
configs/*

# Kerberos ticket loot forged/dumped into the working dir
# (ticketer, getTGT, secretsdump -k) — NEVER commit
*.ccache
*.kirbi

# adidnsdump DNS zone dump written to the working dir — NEVER commit
records.csv

# certipy cert loot (req writes esc1.pfx to the working dir) — NEVER commit
*.pfx

# Keep empty runtime dirs in the tree
!sessions/.gitkeep
!outputs/.gitkeep
!payloads/.gitkeep
!reports/.gitkeep
!dicts/.gitkeep
!tmp/.gitkeep
!cache/.gitkeep
!logs/.gitkeep
!configs/.gitkeep

# ── Secrets & local environment ─────────────────────────────
.env
.env-paths.sh
.apikeys.json
*.bak
*.tmp
*.log

# ── Local tooling / agent config (never push) ───────────────
.claude/

# ── Local-only internal notes (private to the maintainer — never push) ──
docs/internal/

# ── OS / editor noise ───────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/

# NOTE: report PDFs are covered by reports/* above.
# HAWK-Presentation-*.pdf is intentionally versioned (placeholder-only content).
